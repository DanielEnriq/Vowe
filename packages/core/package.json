{
  "name": "@vowe/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./refs": { "types": "./dist/context/refs.d.ts", "default": "./dist/context/refs.js" },
    "./presence": {
      "types": "./dist/product/presence.d.ts",
      "default": "./dist/product/presence.js"
    },
    "./projections": {
      "types": "./dist/product/projections.d.ts",
      "default": "./dist/product/projections.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": { "@types/node": "^22.10.2", "typescript": "^5.7.2" }
}
